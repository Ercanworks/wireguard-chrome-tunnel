{
  "manifest_version": 3,
  "name": "WireGuard Chrome Tunnel",
  "version": "3.0.0",
  "minimum_chrome_version": "137",
  "description": "Tunnels only Chrome (whole browser or a single tab) through a userspace WireGuard SOCKS5 proxy. Generates Proton VPN WireGuard profiles by country.",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "tabs",
    "webRequest",
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "logo.png"
    }
  },
  "icons": {
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
